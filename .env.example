# ==============================================================================
# INFLUENCERS.COM SAAS BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure your local or production values.
# NEVER commit the active .env file or real credentials to source control.

# Mandatory Django cryptographic signing secret; fails closed if unset or empty
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-50-chars

# Debug mode flag (defaults to False when unset; set True only for local development)
DEBUG=True

# Comma-separated list of valid Host header hostnames without wildcards
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of whitelisted frontend origins permitted for cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:5173,http://127.0.0.1:5173

# Redis cache and distributed throttle counter URI (mandatory when DEBUG=False, rediss:// for TLS)
REDIS_URL=redis://127.0.0.1:6379/1

# Count of trusted upstream reverse proxies (0 to trust REMOTE_ADDR directly for rate limiting)
NUM_PROXIES=0

# Frontend URL for creator portal navigation and email links
CREATOR_HUB_URL=http://localhost:8080

# Frontend URL for administrative control panel navigation
ADMIN_PORTAL_URL=http://localhost:8081

# Frontend URL for public discovery marketplace navigation
MARKETPLACE_URL=http://localhost:8082

# Frontend URL for business and brand client portal navigation
BUSINESS_PORTAL_URL=http://localhost:8083

# Django email backend class (use console backend for dev, smtp backend for production)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP server hostname for transactional email dispatch
EMAIL_HOST=smtp.gmail.com

# SMTP server port (usually 587 for STARTTLS or 465 for SSL)
EMAIL_PORT=587

# Enable STARTTLS encryption for SMTP email transmission
EMAIL_USE_TLS=True

# Enable implicit SSL encryption for SMTP email transmission
EMAIL_USE_SSL=False

# Username or email address for authenticating with the SMTP relay
EMAIL_HOST_USER=your-email@example.com

# Password or application-specific password for SMTP relay authentication
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password

# Sender name and default email address for outbound transactional emails
DEFAULT_FROM_EMAIL="Influencers Support" <support@influencers.com>

# Celery task queue broker connection URI (e.g. Redis database 0)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Celery task execution results backend URI
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Execute Celery background tasks synchronously in local dev without a running worker
CELERY_ALWAYS_EAGER=True
